  "typesVersions": {
    "*": {
      "client-intake": [
        "dist/client-intake.d.ts"
      ],
      "integration": [
        "dist/integration-extraction.d.ts"
      ],
      "integration-openapi": [
        "dist/integration-openapi.d.ts"
      ],
      "b2b": [
        "dist/b2b.d.ts"
      ],
      "b2b-openapi": [
        "dist/b2b-openapi.d.ts"
      ],
      "b2b-webhooks": [
        "dist/b2b-webhooks.d.ts"
      ],
      "b2b-security": [
        "dist/b2b-security.d.ts"
      ],
      "b2b-guide-security": [
        "dist/b2b-guide-security.d.ts"
      ],
      "b2b-read-query": [
        "dist/b2b-read-query.d.ts"
      ],
