{
  "name": "@factuez/contracts",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client-intake": {
      "types": "./dist/client-intake.d.ts",
      "require": "./dist/client-intake.js",
      "default": "./dist/client-intake.js"
    },
    "./integration": {
