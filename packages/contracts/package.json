    },
    "./integration-openapi": {
      "types": "./dist/integration-openapi.d.ts",
      "require": "./dist/integration-openapi.js",
      "default": "./dist/integration-openapi.js"
    },
    "./b2b": {
      "types": "./dist/b2b.d.ts",
      "require": "./dist/b2b.js",
      "default": "./dist/b2b.js"
    },
    "./b2b-openapi": {
      "types": "./dist/b2b-openapi.d.ts",
      "require": "./dist/b2b-openapi.js",
      "default": "./dist/b2b-openapi.js"
    },
    "./b2b-webhooks": {
      "types": "./dist/b2b-webhooks.d.ts",
      "require": "./dist/b2b-webhooks.js",
      "default": "./dist/b2b-webhooks.js"
    },
    "./b2b-security": {
      "types": "./dist/b2b-security.d.ts",
