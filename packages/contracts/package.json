      "require": "./dist/b2b-read-query.js",
      "default": "./dist/b2b-read-query.js"
    },
    "./b2b-report-view": {
      "types": "./dist/b2b-report-view.d.ts",
      "require": "./dist/b2b-report-view.js",
      "default": "./dist/b2b-report-view.js"
    },
