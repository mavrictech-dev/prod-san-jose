# Safe installation state. No secrets/mounts/SQL required by this module.
B2B_ONPREM_ADMIN_ENABLED=false
# Preserve SSO as the default UI. ONPREM needs separately confirmed server status.
NEXT_PUBLIC_B2B_ADMIN_PROFILE=SSO
# Keep B2B_PRIVATE_ACCESS as already configured for the existing stack.
# Do not set a config root until main provisions the approved mounted files.
