# Nombre resoluble por DNS interno o por el archivo hosts de cada terminal.
FACTUEZ_HOST=factuez.grifosanjose.lan
FACTUEZ_HTTP_PORT=80
FACTUEZ_HTTPS_PORT=443
FACTUEZ_SECRETS_DIR=./secrets

# Imágenes construidas por el pipeline del monorepo.
KONG_IMAGE=kong:3.9.3
FACTUEZ_IDENTITY_IMAGE=factuez/identity-service:local
FACTUEZ_BILLING_IMAGE=factuez/billing-service:local
FACTUEZ_SUNAT_IMAGE=factuez/sunat-service:local
FACTUEZ_MAILER_IMAGE=factuez/mailer-worker:local
FACTUEZ_REPORTING_IMAGE=factuez/reporting-service:local
FACTUEZ_REALTIME_IMAGE=factuez/realtime-service:local
FACTUEZ_WEB_IMAGE=factuez/web-pwa:local

SUNAT_WORKER_CONCURRENCY=3
MAIL_CONCURRENCY=2

# SOAP publicado por SUNAT. Mantener configurable y verificar antes del pase.
SUNAT_SOAP_BETA_WSDL=https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService?wsdl
SUNAT_SOAP_PRODUCTION_WSDL=https://e-factura.sunat.gob.pe/ol-ti-itcpfegem/billService?wsdl

# Nueva GRE: SUNAT indica que las URI del manual son referenciales. Completar
# con las rutas vigentes entregadas/habilitadas para las credenciales del RUC.
SUNAT_GRE_TOKEN_URL_TEMPLATE=https://api-seguridad.sunat.gob.pe/v1/clientessol/{clientId}/oauth2/token/
SUNAT_GRE_SCOPE=https://api-cpe.sunat.gob.pe
SUNAT_GRE_SUBMIT_URL_BETA=
SUNAT_GRE_STATUS_URL_BETA_TEMPLATE=
SUNAT_GRE_SUBMIT_URL_PRODUCTION=
SUNAT_GRE_STATUS_URL_PRODUCTION_TEMPLATE=
