# Imagen reutilizable para cada microservicio NestJS. El nombre y la ruta se
# proporcionan al construir; cada servicio conserva su propio schema Prisma.
ARG NODE_BASE_IMAGE=node:22-bookworm-slim
FROM ${NODE_BASE_IMAGE}

WORKDIR /workspace
RUN corepack enable
# Una capa común evita repetir la descarga y revisión del mismo lockfile por servicio.
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl libxml2-utils \
    && rm -rf /var/lib/apt/lists/*

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
RUN pnpm fetch --frozen-lockfile
COPY apps ./apps
COPY packages ./packages
COPY services ./services
COPY scripts ./scripts

RUN pnpm install --offline --frozen-lockfile

ARG SERVICE_NAME
ARG SERVICE_PATH
ENV SERVICE_PATH=${SERVICE_PATH}

# El validador GRE ejecuta los XSL oficiales localmente, sin descargas al arrancar.
RUN if [ "$SERVICE_NAME" = "@factuez/sunat-service" ]; then \
    apt-get update && apt-get install -y --no-install-recommends python3 python3-lxml \
    && rm -rf /var/lib/apt/lists/*; fi

# Prisma sólo necesita una URL sintácticamente válida para generar el cliente;
# no establece conexión durante el build de la imagen.
RUN export DATABASE_URL=postgresql://build:build@localhost:5432/build NODE_PATH="/workspace/${SERVICE_PATH}/node_modules"; \
    pnpm --filter "${SERVICE_NAME}^..." --recursive --if-present run build && \
    pnpm --filter "${SERVICE_NAME}" --if-present run db:generate && \
    pnpm --filter "${SERVICE_NAME}" build

CMD ["sh", "-c", "node \"$SERVICE_PATH/dist/main.js\""]
